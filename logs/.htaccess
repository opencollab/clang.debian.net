# The pages link the logs by their real .gz name (build_log_url() in
# listErrors.php), and the root .htaccess takes care of serving them as inline
# plain text. This file only keeps the *old* uncompressed URLs alive: they were
# published for years in the PTS and in bug reports, e.g.
#   /logs/2021-10-25-13.0.0/foo_1.0-1_unstable_clang13.0.0.log
#
# Requires mod_rewrite and "AllowOverride FileInfo Options" on this directory.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /logs/

    # If the plain file is gone but the gzipped one exists, serve the .gz
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.gz -f
    RewriteRule ^(.*)$ $1.gz [L]
</IfModule>

# The rewrite above only covers the .gz suffix. Links published before the
# rebuild directories and the file names gained a clang version also have the
# wrong directory or the wrong suffix, so hand those to resolve-log.php, which
# looks the package up among the rebuilds actually on disk.
ErrorDocument 404 /resolve-log.php
